# Copy to `.env` for local development. Never commit `.env`.
# All values are optional: the defaults run fully offline with the mock AI provider.

APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
AZURE_SDK_LOG_LEVEL=WARNING     # Azure SDK HTTP/credential logging (INFO is very verbose)

# --- AI provider -------------------------------------------------------------------------
AI_PROVIDER=mock                 # mock | azure_openai | disabled

# Azure OpenAI (only when AI_PROVIDER=azure_openai). The app calls <endpoint>/openai/v1/.
AZURE_OPENAI_ENDPOINT=           # e.g. https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=         # your model *deployment* name, not the model name
# Leave empty to use Microsoft Entra ID (recommended): `az login` locally, managed identity in
# Azure. The identity needs the "Cognitive Services OpenAI User" role on the resource.
AZURE_OPENAI_API_KEY=

# --- AI request limits -------------------------------------------------------------------
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_CONTEXT_CHARS=12000

# --- Cost estimate (price per 1M tokens). 0 = not configured, no estimate shown.
# Look up current prices for your model and region on the Azure OpenAI pricing page.
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0
AI_PRICE_CURRENCY=USD

# --- Public demo protection --------------------------------------------------------------
CHAT_MAX_QUESTION_CHARS=500
SESSION_REQUEST_LIMIT=10
GLOBAL_DAILY_REQUEST_LIMIT=200
GLOBAL_DAILY_COST_LIMIT=1.00     # daily budget for *estimated* AI cost, in AI_PRICE_CURRENCY
USAGE_STORE=memory               # memory | sqlite | azure_table
# USAGE_SQLITE_PATH=.data/usage.sqlite3

# Azure Table Storage (production): managed identity, no keys.
# AZURE_TABLE_ENDPOINT=https://<account>.table.core.windows.net
# AZURE_TABLE_NAME=aiusage
# Local Azurite only (refused when APP_ENV=production). This is Azurite's public dev key:
# AZURE_TABLE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;TableEndpoint=http://azurite:10002/devstoreaccount1;

# With APP_ENV=production, live Azure OpenAI calls are blocked unless USAGE_STORE=azure_table is
# reachable AND model prices are configured (otherwise the cost budget cannot be enforced).

RETRIEVAL_TOP_K=3

# --- Asynchronous invoice processing (off by default) -------------------------------------
# Upload → Blob Storage → Event Grid → Service Bus → worker job → Table Storage.
# ASYNC_PROCESSING_ENABLED=false
# SUBMISSION_BACKEND=local           # local = in-process simulation | azure
# SUBMISSION_MAX_BYTES=65536
# SUBMISSION_SESSION_DAILY_LIMIT=10  # upload allowance — separate from the AI allowance above
# SUBMISSION_GLOBAL_DAILY_LIMIT=200
# SUBMISSION_RETENTION_DAYS=7
# UPLOAD_CONTAINER=invoice-uploads
# SUBMISSIONS_TABLE=invoicejobs
# AZURE_BLOB_ENDPOINT=https://<account>.blob.core.windows.net   (managed identity)
# Local Azurite only (refused when APP_ENV=production):
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Worker job (python -m invoiceiq.worker). Values must match the Service Bus queue.
# SERVICEBUS_NAMESPACE=<namespace>.servicebus.windows.net   (managed identity)
# SERVICEBUS_QUEUE=invoice-events
# WORKER_MAX_DELIVERY_COUNT=5
# WORKER_LEASE_SECONDS=60
# WORKER_RUN_BUDGET_SECONDS=240      # below the job's replica timeout
